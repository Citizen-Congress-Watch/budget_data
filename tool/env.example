# Keystone GraphQL base URL
KEYSTONE_URL=YOUR_KEYSTONE_URL

# Optional bearer token if API requires auth
# KEYSTONE_TOKEN=xxxxxxxx

# Batch size per GraphQL query（預設 1000）
# BATCH_SIZE=1000

# 匯出上限筆數（預設 10，正式匯出時可改大或刪除）
# MAX_RECORDS=50000

# 自訂輸出資料夾（預設為 budget_data/）
# OUTPUT_DIR=/absolute/path/to/budget_data

# 進階過濾條件（JSON）
# PROPOSAL_WHERE_JSON={"publishStatus":{"equals":"published"}}

# local 輸出，在終端機進到 tool 資料夾，打 npm run export:proposals


